{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/blog/tlc-license-explained",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/guides/tlc-license-explained",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ariablackcarservice.com"
        }
      ],
      "destination": "https://ariablackcarservice.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.ariablackcarservice.com"
        }
      ],
      "destination": "https://ariablackcarservice.com/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
