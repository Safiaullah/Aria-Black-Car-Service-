{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/airports",
      "destination": "/services/airport-transfer",
      "permanent": true
    },
    {
      "source": "/corporate/shuttle-service",
      "destination": "/services/corporate-shuttle",
      "permanent": true
    },
    {
      "source": "/events/sporting",
      "destination": "/services/sporting-events",
      "permanent": true
    },
    {
      "source": "/corporate/executive-travel",
      "destination": "/services/executive-car-service",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "https://book.ariablackcarservice.com/book",
      "permanent": true
    },
    {
      "source": "/blog/tlc-license-explained",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/guides/tlc-license-explained",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ariablackcarservice.com"
        }
      ],
      "destination": "https://ariablackcarservice.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.ariablackcarservice.com"
        }
      ],
      "destination": "https://ariablackcarservice.com/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
